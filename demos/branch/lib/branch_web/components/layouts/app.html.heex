<header class="border-b border-zinc-800 bg-zinc-950">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3">
    <a href="/" class="font-semibold tracking-tight text-zinc-100">
      branch <span class="font-normal text-zinc-500">— a branching SQLite service</span>
    </a>
    <p class="text-xs text-zinc-500">
      one cell per branch · fast-forward or refuse
    </p>
  </div>
</header>
<main class="mx-auto max-w-7xl px-6 py-8">
  <.flash_group flash={@flash} />
  {@inner_content}
</main>
