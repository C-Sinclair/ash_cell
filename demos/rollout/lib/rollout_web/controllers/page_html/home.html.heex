<!-- The visualiser. Every dot is a real POST /v1/check; every button is a real write.

     A whole document rather than a layout fragment: this page is rendered with
     layouts off, because the scaffolded layout links an asset bundle the app has no
     pipeline to build. -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>rollout — OTA on AshCell</title>
    <link rel="icon" href="/favicon.ico" />
    <style>
      :root {
        --bg: #0b0d12;
        --panel: #12151d;
        --line: #232838;
        --text: #e6e9f0;
        --dim: #7d859b;
        --prod: #4ade80;
        --beta: #60a5fa;
        --canary: #fbbf24;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 14px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      header {
        padding: 20px 28px 14px;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: baseline;
        gap: 18px;
        flex-wrap: wrap;
      }

      h1 { font-size: 15px; margin: 0; font-weight: 600; letter-spacing: 0.02em; }
      header p { margin: 0; color: var(--dim); font-size: 12px; }

      main { padding: 22px 28px 40px; display: grid; gap: 22px; }

      .panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 18px 20px;
      }

      .panel h2 {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--dim);
        margin: 0 0 4px;
        font-weight: 600;
      }

      .panel .note { color: var(--dim); font-size: 12px; margin: 0 0 16px; }

      .channel {
        display: grid;
        grid-template-columns: 168px 1fr 200px;
        align-items: center;
        gap: 14px;
        padding: 10px 0;
        border-top: 1px solid var(--line);
      }

      .channel:first-of-type { border-top: 0; }

      .name { display: flex; align-items: center; gap: 8px; font-size: 13px; }
      .swatch { width: 9px; height: 9px; border-radius: 50%; flex: none; }

      /* The lane a request travels down. Client on the left, server on the right. */
      .lane {
        position: relative;
        height: 46px;
        border-left: 2px solid var(--line);
        border-right: 2px solid var(--line);
      }

      .lane .edge {
        position: absolute;
        top: -14px;
        font-size: 10px;
        color: var(--dim);
        letter-spacing: 0.06em;
      }

      .lane .edge.left { left: 4px; }
      .lane .edge.right { right: 4px; }

      /* One in-flight request. Travels right, turns around at the server, comes back
         carrying the version it was told. */
      .dot {
        position: absolute;
        top: 50%;
        left: 0;
        width: 9px;
        height: 9px;
        margin-top: -4.5px;
        border-radius: 50%;
        animation: out 900ms cubic-bezier(0.4, 0, 0.6, 1) forwards;
      }

      .dot.back { animation: back 900ms cubic-bezier(0.4, 0, 0.6, 1) forwards; }

      .dot .label {
        position: absolute;
        left: 14px;
        top: -6px;
        white-space: nowrap;
        font-size: 11px;
        opacity: 0;
      }

      .dot.back .label { opacity: 1; }

      @keyframes out {
        from { transform: translateX(0); }
        to { transform: translateX(calc(100% * var(--travel))); }
      }

      @keyframes back {
        from { transform: translateX(calc(100% * var(--travel))); opacity: 1; }
        to { transform: translateX(0); opacity: 0; }
      }

      .state { text-align: right; font-size: 12px; }
      .state .version { font-size: 16px; font-weight: 600; }
      .state .meta { color: var(--dim); font-size: 11px; }

      .controls { display: flex; gap: 8px; justify-content: flex-end; margin-top: 6px; }

      button {
        font: inherit;
        font-size: 12px;
        padding: 5px 11px;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: #1a1f2b;
        color: var(--text);
        cursor: pointer;
      }

      button:hover { border-color: #39415a; }
      button:disabled { opacity: 0.4; cursor: default; }

      /* The blob lane. Deliberately dumber than the one above: a path, a filename, and
         nothing in the middle -- which is the point being made. */
      .blobs { position: relative; height: 128px; }

      .blob-lane {
        position: absolute;
        left: 120px;
        right: 120px;
        height: 1px;
        background: var(--line);
      }

      .blob-endpoint {
        position: absolute;
        top: -9px;
        font-size: 11px;
        color: var(--dim);
      }

      .blob-endpoint.left { left: -108px; }
      .blob-endpoint.right { right: -104px; }

      .packet {
        position: absolute;
        top: -9px;
        left: 0;
        font-size: 11px;
        white-space: nowrap;
        animation: ship 1400ms linear forwards;
      }

      @keyframes ship {
        from { transform: translateX(0); opacity: 0; }
        12%  { opacity: 1; }
        88%  { opacity: 1; }
        to   { transform: translateX(calc(100% * var(--travel))); opacity: 0; }
      }

      .legend { color: var(--dim); font-size: 11px; margin-top: 10px; }
      .counts { color: var(--dim); font-size: 11px; }
    </style>
  </head>
  <body>
    <header>
      <h1>rollout — over-the-air updates on AshCell</h1>
      <p>
        every dot is a real <code>POST /v1/check</code>; every button is a real write to that channel's cell
      </p>
    </header>

    <main>
      <section class="panel">
        <h2>Check-in</h2>
        <p class="note">
          A device says what it is and what it already has. The channel answers from its
          pointer — cached in <code>persistent_term</code>, invalidated by its own writer —
          and writes nothing.
        </p>

        <div id="channels">
          <div :for={channel <- @channels} class="channel" data-channel={channel}>
            <div class="name">
              <span class="swatch" data-swatch></span>
              <span>{channel}</span>
            </div>

            <div class="lane">
              <span class="edge left">client</span>
              <span class="edge right">channel cell</span>
            </div>

            <div class="state">
              <div class="version" data-version>—</div>
              <div class="meta" data-meta></div>
              <div class="controls">
                <button data-action="upgrade">upgrade</button>
                <button data-action="rollback">rollback</button>
              </div>
            </div>
          </div>
        </div>

        <p class="legend">
          A dot travels out, turns around at the cell, and comes back carrying the version
          it was told. A hollow dot was told <code>up_to_date</code> — either it is already
          current, or it is outside a staged rollout.
        </p>
      </section>

      <section class="panel">
        <h2>Blob fetch</h2>
        <p class="note">
          What a device does once it has been told a version. Straight to the object store,
          no cell involved — the pointer graph is a few KB and the payload is everything
          else, which is the split the whole design rests on.
        </p>

        <div class="blobs">
          <div class="blob-lane" id="blob-lane">
            <span class="blob-endpoint left">client</span>
            <span class="blob-endpoint right">object store</span>
          </div>
        </div>

        <p class="counts" id="counts"></p>
      </section>
    </main>

    <script>
      // Colour per channel. Order matches the seed: prod, beta, canary.
      const COLOURS = ["--prod", "--beta", "--canary"];

      const rows = [...document.querySelectorAll(".channel")].map((row, index) => {
        const colour = getComputedStyle(document.documentElement)
          .getPropertyValue(COLOURS[index % COLOURS.length])
          .trim();

        row.querySelector("[data-swatch]").style.background = colour;

        return {
          channel: row.dataset.channel,
          colour,
          lane: row.querySelector(".lane"),
          version: row.querySelector("[data-version]"),
          meta: row.querySelector("[data-meta]"),
          buttons: [...row.querySelectorAll("button")],
          row,
        };
      });

      const blobLane = document.getElementById("blob-lane");
      const counts = document.getElementById("counts");
      const tally = { update: 0, up_to_date: 0, no_release: 0 };

      let device = 0;

      // A dot is spawned when the request goes out and turned around when it lands, so
      // its outbound travel really is the request being in flight.
      function spawn(row) {
        const dot = document.createElement("div");
        dot.className = "dot";
        dot.style.setProperty("--travel", laneTravel(row.lane));
        dot.style.background = row.colour;

        const label = document.createElement("span");
        label.className = "label";
        label.style.color = row.colour;
        dot.appendChild(label);

        row.lane.appendChild(dot);
        return { dot, label };
      }

      // The lane is wider than the dot, so the dot has to travel (lane - dot) / dot
      // times its own width to reach the far edge.
      function laneTravel(lane) {
        return (lane.clientWidth - 13) / 9;
      }

      function turnAround({ dot, label }, text, filled) {
        label.textContent = text;
        if (!filled) {
          dot.style.background = "transparent";
          dot.style.boxShadow = "inset 0 0 0 1.5px currentColor";
          dot.style.color = dot.style.color || "";
        }
        dot.classList.add("back");
        setTimeout(() => dot.remove(), 950);
      }

      function ship(row, filename) {
        const packet = document.createElement("div");
        packet.className = "packet";
        packet.style.color = row.colour;
        packet.style.setProperty("--travel", "1");
        packet.textContent = "── " + filename + " ─▶";
        blobLane.appendChild(packet);
        setTimeout(() => packet.remove(), 1450);
      }

      async function checkIn(row) {
        const flight = spawn(row);
        device += 1;

        try {
          const response = await fetch("/v1/check", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              channel: row.channel,
              device_id: "phone-" + device,
              platform: "ios",
              arch: "arm64",
              runtime: 142,
              current_release: null,
            }),
          });

          const body = await response.json();
          tally[body.status] = (tally[body.status] || 0) + 1;

          if (body.status === "update") {
            turnAround(flight, body.version, true);
            const bundle = body.artifacts.find((a) => a.kind === "bundle");
            if (bundle) ship(row, "bundle-" + body.version + ".js");
          } else if (body.status === "up_to_date") {
            turnAround(flight, "up to date", false);
          } else {
            turnAround(flight, body.status.replace("_", " "), false);
          }

          render();
        } catch (error) {
          turnAround(flight, "error", false);
        }
      }

      function render() {
        counts.textContent =
          tally.update + " served · " + tally.up_to_date + " up to date" +
          (tally.no_release ? " · " + tally.no_release + " no release" : "");
      }

      async function refresh(row) {
        const response = await fetch("/v1/channels/" + row.channel);
        const body = await response.json();

        row.version.textContent = body.version || "—";
        row.version.style.color = row.colour;
        row.meta.textContent =
          body.rollout + "% · " + (body.cached ? "cached" : "cold") +
          (body.history.length ? " · " + body.history[0].kind : "");
      }

      async function act(row, action) {
        row.buttons.forEach((b) => (b.disabled = true));

        try {
          await fetch("/v1/" + action + "/" + row.channel, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ reason: action + " from the console" }),
          });
          await refresh(row);
        } finally {
          row.buttons.forEach((b) => (b.disabled = false));
        }
      }

      rows.forEach((row) => {
        row.buttons.forEach((button) =>
          button.addEventListener("click", () => act(row, button.dataset.action))
        );

        refresh(row);

        // Staggered per channel so the three lanes do not pulse in lockstep, which
        // would read as one event rather than three independent fleets.
        setInterval(() => checkIn(row), 700);
        setTimeout(() => checkIn(row), Math.random() * 700);
      });

      setInterval(() => rows.forEach(refresh), 2000);
      render();
    </script>
  </body>
</html>
